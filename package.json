{
  "name": "wika-ppf-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "optimize-media": "node scripts/optimize-media.mjs && node scripts/make-compare.mjs",
    "build": "tsc -p tsconfig.json && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/make-og.mjs && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json",
    "og": "vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/make-og.mjs --force"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
